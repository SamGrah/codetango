---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate, readingTime } from '../lib/utils';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <div class="home-band grid">
    <div class="slab field"><h1>Posts</h1></div>
    <div class="post-bar field field--two" aria-hidden="true"></div>
    <div class="quarter field field--ochre" aria-hidden="true"></div>
  </div>
  <ol class="listing">
    {
      posts.map((post) => (
        <li class="entry grid">
          <time class="entry-date" datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatDate(post.data.date)}
          </time>
          <h2 class="entry-title">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          {post.data.synopsis && <p class="entry-synopsis">{post.data.synopsis}</p>}
          <p class="entry-meta">
            {post.data.categories[0] && <span class="cat">{post.data.categories[0]}</span>}
            <span class="len">{readingTime(post.body ?? '')} min read</span>
          </p>
          {post.data.tags.length > 0 && <p class="entry-tags">{post.data.tags.join(', ')}</p>}
        </li>
      ))
    }
  </ol>
</Base>
